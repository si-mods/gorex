# Cloudflare Workers static assets: headers for web/dist (build.mjs copies
# this file there); see docs/web-client.md. The script and its code chunks,
# the wasm, the asset manifest, the themes and the tailnet engine are in
# /assets under names that carry a hash of their content, so they are kept
# a year (immutable): a reload takes them from the browser's cache without
# asking. The page itself (/ and index.html), which names the script, is
# revalidated (ETag) on every load; the fonts, icons and brand marks are
# kept a day. A path that two rules match gets both rules'
# headers, so the rules below set different headers or match different
# paths. The Tailscale hosts in connect-src are what built-in Tailscale
# needs (docs/web-tailscale.md, CSP); http: and https: already cover them,
# for the hosts the user adds, but they stay named for when that narrows.
# sw.js, the Service Worker, and the manifest are revalidated on every load
# too, so that a new build is found; the app icons in /pwa are kept a day.
/*
  Content-Security-Policy: default-src 'none'; script-src 'self' 'wasm-unsafe-eval'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self'; frame-src http: https:; connect-src 'self' http: https: ws: wss: https://controlplane.tailscale.com wss://controlplane.tailscale.com wss://*.tailscale.com; manifest-src 'self'; worker-src 'self'; base-uri 'none'; form-action 'none'; frame-ancestors 'none'
  X-Content-Type-Options: nosniff
  Referrer-Policy: no-referrer

/
  Cache-Control: no-cache
/index.html
  Cache-Control: no-cache
/fonts/*
  Cache-Control: public, max-age=86400
/icons/*
  Cache-Control: public, max-age=86400
/brands/*
  Cache-Control: public, max-age=86400
/sw.js
  Cache-Control: no-cache
/manifest.webmanifest
  Cache-Control: no-cache
  Content-Type: application/manifest+json
/pwa/*
  Cache-Control: public, max-age=86400
/assets/*
  Cache-Control: public, max-age=31536000, immutable
