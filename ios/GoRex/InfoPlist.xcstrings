{
  "sourceLanguage": "en",
  "version": "1.0",
  "strings": {
    "NSCameraUsageDescription": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Rex Go scans the pairing QR code that GoRex or Rex shows."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Rex Go 用相机扫描 GoRex 或 Rex 显示的配对二维码。"
          }
        }
      }
    },
    "NSLocalNetworkUsageDescription": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Rex Go connects to your computers on the local network."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Rex Go 通过本地网络连接你的电脑。"
          }
        }
      }
    },
    "NSMicrophoneUsageDescription": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Rex Go hears what you say while the mic is on, and types it into the terminal. Speech is recognised on this device."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "麦克风打开时，Rex Go 听你说话，并把它打进终端。语音在本机上识别。"
          }
        }
      }
    }
  }
}
