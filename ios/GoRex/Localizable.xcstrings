      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "公钥"
          }
        }
      }
    },
    "Quick Launchers": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "快捷启动"
          }
        }
      }
    },
    "Quick Launchers…": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "快捷启动…"
          }
        }
      }
    },
    "Reach this host through Rex Go's own Tailscale, not the phone's network or the Tailscale app. With built-in Tailscale off, it goes the phone's way.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "经由 Rex Go 自带的 Tailscale 连接此主机，而不是手机网络或 Tailscale App。内置 Tailscale 关闭时，按手机的方式连接。"
          }
        }
      }
    },
    "Ready": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "就绪"
          }
        }
      }
