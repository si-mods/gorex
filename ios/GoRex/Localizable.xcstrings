{
  "sourceLanguage": "en",
  "strings": {
    "%@ Is a Project Already": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 已是项目"
          }
        }
      }
    },
    "%@ is not on %@ any more, so no tab of %@ can open in it.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%2$@ 上已没有 %1$@，%3$@ 的标签页无法在其中打开。"
          }
        }
      }
    },
    "%@ is not on %@ any more.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%2$@ 上已没有 %1$@。"
          }
        }
      }
    },
    "%@ needs input": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 需要输入"
          }
        }
      }
    },
    "%@ · Full Catalog": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ · 完整功能目录"
          }
        }
      }
    },
    "%@: %@": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@：%@"
          }
        }
      }
    },
    "%@@%@:%@ answered with a different key than the one trusted before. This could be a man-in-the-middle attack, or the host was reinstalled.\n\nTrusted: %@\nNew (%@): %@": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@@%2$@:%3$@ 返回的密钥与此前信任的不一致。这可能是中间人攻击，或该主机已重装。\n\n已信任：%4$@\n新密钥（%5$@）：%6$@"
          }
        }
      }
    },
    "%lld Features and Details": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld 项功能与细节"
          }
        }
      }
    },
    "%lld Images": {
      "localizations": {
        "en": {
          "variations": {
            "plural": {
              "one": {
                "stringUnit": {
                  "state": "translated",
                  "value": "%lld Image"
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "%lld Images"
                }
              }
            }
          }
        },
        "zh-Hans": {
          "variations": {
            "plural": {
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "%lld 张图片"
                }
              }
            }
          }
        }
      }
    },
    "%lld Images, New": {
      "localizations": {
        "en": {
          "variations": {
            "plural": {
              "one": {
                "stringUnit": {
                  "state": "translated",
                  "value": "%lld Image, New"
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "%lld Images, New"
                }
              }
            }
          }
        },
        "zh-Hans": {
          "variations": {
            "plural": {
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "%lld 张图片，有新图片"
                }
              }
            }
          }
        }
      }
    },
    "%lld needs you": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld 项待处理"
          }
        }
      }
    },
    "%lld of %lld": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "第 %lld 项，共 %lld 项"
          }
        }
      }
    },
    "%lld projects": {
      "localizations": {
        "en": {
          "variations": {
            "plural": {
              "one": {
                "stringUnit": {
                  "state": "translated",
                  "value": "%lld project"
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "%lld projects"
                }
              }
            }
          }
        },
        "zh-Hans": {
          "variations": {
            "plural": {
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "%lld 个项目"
                }
              }
            }
          }
        }
      }
    },
    "%lld pt": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld pt"
          }
        }
      }
    },
    "4.5 (WCAG AA)": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "4.5（WCAG AA）"
          }
        }
      }
    },
    "7 (WCAG AAA)": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "7（WCAG AAA）"
          }
        }
      }
    },
    "861 Ghostty themes, each with a swatch, a filter of All, Dark and Light, and a search. A preview shows the chosen one in the terminal's font.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "861 款 Ghostty 主题，每款都有色板，可按全部、深色、浅色筛选，也能搜索。预览以终端字体展示所选主题。"
          }
        }
      }
    },
    "A Ghostty terminal": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Ghostty 终端"
          }
        }
      }
    },
    "A bell gives a light tap, at most two a second.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "响铃时轻微震动，每秒最多两次。"
          }
        }
      }
    },
    "A control server's URL starts with https://, or http:// for a local address.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "控制服务器的 URL 须以 https:// 开头；本地地址可用 http://。"
          }
        }
      }
    },
    "A device name has letters, digits and hyphens, not at either end.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "设备名称只能包含字母、数字和连字符，且连字符不能在首尾。"
          }
        }
      }
    },
    "A drag follows the finger, a flick coasts and slows, and the ends bounce. Full-screen programs and those that use the mouse get the scroll as wheel events.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "拖动跟手，轻扫后惯性减速，到头会回弹。全屏程序和使用鼠标的程序收到的是滚轮事件。"
          }
        }
      }
    },
    "A folder is not downloaded": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "暂不支持下载文件夹"
          }
        }
      }
    },
    "A font with Chinese and Nerd Font glyphs, to download. Only its four faces download, about 40 MB; stop it or delete it at any time.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "一款含中文和 Nerd Font 图标的可下载字体。只下载四种字形，约 40 MB，可随时停止或删除。"
          }
        }
      }
    },
    "A half-height photo picker": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "半屏照片选择器"
          }
        }
      }
    },
    "A host that is offline shows its projects and their tabs greyed, as Rex Go last saw them.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "离线的主机以灰色显示它的项目和标签页，内容是 Rex Go 上次看到的样子。"
          }
        }
      }
    },
    "A key bar that stays": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "常驻的按键栏"
          }
        }
      }
    },
    "A label for this device": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "本设备的标签"
          }
        }
      }
    },
    "A label for this key, such as Work Server or Personal.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "为该密钥起一个名称，例如「工作服务器」或「个人」。"
          }
        }
      }
    },
    "A line of progress": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "进度条"
          }
        }
      }
    },
    "A long press selects the word under the finger, with the loupe. Drag to select more; past the top or bottom the terminal scrolls on.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "长按选中手指下的单词，并显示放大镜。拖动可扩大选区，拖到顶部或底部时终端会继续滚动。"
          }
        }
      }
    },
    "A notification opens its terminal. The terminal on screen sends none.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "轻点通知会打开对应的终端。正在查看的终端不会发通知。"
          }
        }
      }
    },
    "A program in this pane is not listening on a TCP port.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这个分屏中的程序没有在监听 TCP 端口。"
          }
        }
      }
    },
    "A program that uses the mouse gets a tap as a click, and the keyboard stays up.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "使用鼠标的程序会把轻点当作点击，键盘保持弹出。"
          }
        }
      }
    },
    "A program's progress (OSC 9;4) shows as a thin line at the top, red on an error.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "程序报告的进度（OSC 9;4）显示为顶部的一条细线，出错时变红。"
          }
        }
      }
    },
    "A project from a folder": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "用文件夹新建项目"
          }
        }
      }
    },
    "A space is the name on its projects. Renaming one renames it on every host; deleting one moves its projects to Default. A host that is offline takes the change when it connects.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "空间是项目上的名称。重命名空间会在每台主机上生效；删除空间会把它的项目移到“默认”。离线的主机在连上后执行更改。"
          }
        }
      }
    },
    "A tcp:// endpoint of an ssh:// address is host:port, like tcp://127.0.0.1:7297.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "ssh:// 地址的 tcp:// 端点格式为 主机:端口，例如 tcp://127.0.0.1:7297。"
          }
        }
      }
    },
    "A terminal opens in the background last seen on its host, so it does not flash.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "终端以该主机上次的背景色打开，不会闪烁。"
          }
        }
      }
    },
    "A terminal that can't connect offers Diagnostics: where it stopped, the path to the host, pings of three sizes and the recent log, to copy into a report. A GoRex machine in Settings › Tailscale opens the same.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "连不上的终端提供“诊断”：卡在哪一步、到主机的路径、三种大小的 ping 和最近的日志，可复制到问题报告里。在“设置 › Tailscale”中轻点一台 GoRex 电脑也能打开。"
          }
        }
      }
    },
    "API Key": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "API 密钥"
          }
        }
      }
    },
    "About": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "关于"
          }
        }
      }
    },
    "About System": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "System"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "系统"
          }
        }
      }
    },
    "Activity under the eye": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "眼睛图标下的动态"
          }
        }
      }
    },
    "Actual Size": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "实际大小"
          }
        }
      }
    },
    "Add": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "添加"
          }
        }
      }
    },
    "Add Attachment": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "添加附件"
          }
        }
      }
    },
    "Add File": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "添加文件"
          }
        }
      }
    },
    "Add Host": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "添加主机"
          }
        }
      }
    },
    "Add Photo": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "添加照片"
          }
        }
      }
    },
    "Add a Host": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "添加主机"
          }
        }
      }
    },
    "Add this line to ~/.ssh/authorized_keys on any SSH host.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "将此行添加到任意 SSH 主机的 ~/.ssh/authorized_keys 中。"
          }
        }
      }
    },
    "Address": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "地址"
          }
        }
      }
    },
    "Algorithm": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "算法"
          }
        }
      }
    },
    "All": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "全部"
          }
        }
      }
    },
    "Allow Rex Go to use the microphone in Settings.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请在“设置”中允许 Rex Go 使用麦克风。"
          }
        }
      }
    },
    "Allow camera access in Settings, or set up the host manually.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请在“设置”中允许访问相机，或手动设置主机。"
          }
        }
      }
    },
    "Amber": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "琥珀色"
          }
        }
      }
    },
    "An arrow stick": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "方向摇杆"
          }
        }
      }
    },
    "An ssh:// address has no spaces or query.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "ssh:// 地址不能包含空格或查询参数。"
          }
        }
      }
    },
    "An ssh:// address needs a host, like ssh://alice@alice-laptop.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "ssh:// 地址需要包含主机名，例如 ssh://alice@alice-laptop。"
          }
        }
      }
    },
    "An ssh:// address needs the user to log in as, like ssh://alice@alice-laptop.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "ssh:// 地址需要包含登录用户名，例如 ssh://alice@alice-laptop。"
          }
        }
      }
    },
    "An ssh:// address takes a socket or a tcp:// endpoint, not both.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "ssh:// 地址只能指定 socket 或 tcp:// 端点之一，不能同时填写。"
          }
        }
      }
    },
    "An ssh:// address takes its pairing token as #k=<token>.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "ssh:// 地址的配对令牌格式为 #k=<token>。"
          }
        }
      }
    },
    "An ssh:// socket is an absolute path, like /run/rex/server.sock.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "ssh:// 的 socket 须为绝对路径，例如 /run/rex/server.sock。"
          }
        }
      }
    },
    "App Icon": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "应用图标"
          }
        }
      }
    },
    "Appearance": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "外观"
          }
        }
      }
    },
    "Arrow Keys": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "方向键"
          }
        }
      }
    },
    "Asking %@ to pair…": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "正在请求与 %@ 配对…"
          }
        }
      }
    },
    "Auth Key": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "认证密钥"
          }
        }
      }
    },
    "Authentication": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "认证方式"
          }
        }
      }
    },
    "Automatic": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "自动"
          }
        }
      }
    },
    "Back": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "返回"
          }
        }
      }
    },
    "Back from the background, the terminal connects again and every title stays. A dropped connection tries again by itself.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "从后台返回时终端自动重连，所有标题都保留。连接中断时会自动重试。"
          }
        }
      }
    },
    "Back where you left it": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "回来时一切如旧"
          }
        }
      }
    },
    "Backspace on the key bar repeats while held, as the keyboard's does.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "按住按键栏上的退格会连续删除，与系统键盘一样。"
          }
        }
      }
    },
    "Base URL": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Base URL"
          }
        }
      }
    },
    "Bells": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "响铃"
          }
        }
      }
    },
    "Bigger Text": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "放大文字"
          }
        }
      }
    },
    "Blue": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "蓝色"
          }
        }
      }
    },
    "Built-in Tailscale": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "内置 Tailscale"
