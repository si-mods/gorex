            "state": "translated",
            "value": "Tab"
          }
        }
      }
    },
    "Terminal": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "终端"
          }
        }
      }
    },
    "The connection was lost.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "连接已断开。"
          }
        }
      }
    },
    "The program exited with code %lld.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "程序已退出，退出码 %lld。"
          }
        }
      }
    },
    "The server refused the terminal.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "服务器拒绝了这个终端。"
          }
        }
      }
    },
    "The terminal's snapshot could not be read.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法读取终端快照。"
          }
        }
      }
    },
    "The window closed.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "窗口已关闭。"
          }
        }
      }
    },
    "Themes": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "主题"
          }
        }
      }
