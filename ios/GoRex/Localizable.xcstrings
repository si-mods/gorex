    "Ping": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Ping"
          }
        }
      }
    },
    "Pink": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "粉色"
          }
        }
      }
    },
    "Pinned agent CLIs appear in this project's quick-launcher row. Turn all off to show New Tab.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "固定的 Agent CLI 会显示在此项目的快捷启动栏中。全部关闭则恢复显示「新建标签页」。"
          }
        }
      }
    },
    "Pins the compose bar above the key bar and moves the mic into it, so typing and dictation land in the message field for you to read before Send. It takes effect on a terminal opened after the change.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Pins the compose bar above the key bar and moves the mic into it, so typing and dictation land in the message field for you to read before Send. It takes effect on a terminal opened after the change."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "把 compose 栏固定在键栏上方，并把麦克风移入其中：输入与听写都先进入消息字段，供你在 Send 前查看。该改动对之后打开的终端生效。"
          }
        }
      }
    },
    "Pinyin and other input methods compose at the cursor, with their candidates beside it, and send the text once it is done.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "拼音等输入法在光标处显示输入中的文字，候选词就在旁边，选定后一次性发送。"
          }
        }
      }
    },
    "Pointer and trackpad": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "指针与触控板"
          }
        }
      }
    },
    "Polishing": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "正在润色"
          }
        }
      }
    },
    "Port": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "端口"
          }
        }
      }
    },
    "Port must be between 1 and 65535, or blank for 22.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "端口须在 1 到 65535 之间，留空则默认为 22。"
          }
        }
      }
    },
    "Prism": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "棱镜"
          }
        }
      }
