    "Record Keyboard Input": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "记录键盘输入"
          }
        }
      }
    },
    "Records what the keyboard sends the terminal, typed text included, to copy into a report of a keyboard bug. The log stays in memory until the app quits; turning recording off clears it.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "记录键盘发给终端的内容（包括输入的文字），可复制到键盘问题的报告里。日志只保存在内存中，直到 App 退出；关闭记录即清空。"
          }
        }
      }
    },
    "Refused: sign Rex Go in as the Tailscale user who signed in the GoRex machine, not with a tagged key, or turn on --allow-tailnet-members there.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "被拒绝：请用登录 GoRex 电脑的同一 Tailscale 用户登录 Rex Go，不要用带标签的密钥；或在那台电脑上开启 --allow-tailnet-members。"
          }
        }
      }
    },
    "Reload": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "重新加载"
          }
        }
      }
    },
    "Remote Hosts": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "远程主机"
          }
        }
