#!/bin/bash
# test-notes: set a TestFlight build's What to Test, per locale, to the
# bullets ios/WhatToTest.md gained since another commit: a tester's view of
# what changed, written for them, not the commits that made it.
#
#   test-notes VERSION BUILD FROM [TO]  set the build's notes; TO is HEAD
#   test-notes check [BASE] [TO]        what a pull request owes testers: a
#                                       bullet in each locale when it changes
#                                       what they see, and no bullet that
#                                       reads like a commit subject
#
# FROM is the commit of the last build that uploaded. The key is upload's:
# ASC_KEY_PATH, ASC_KEY_ID and ASC_ISSUER_ID. A build just uploaded shows in
# App Store Connect after a while, so setting its notes tries for 20 minutes.
set -euo pipefail
cd "$(dirname "$0")/.." # ios/, whose scripts this shares
. scripts/asc-env
cd .. # the repository root: the paths below are its
export ASC_KEY_ID ASC_ISSUER_ID ASC_PRIVATE_KEY_PATH

# The locales set, each from its section of ios/WhatToTest.md.
LOCALES="en-US zh-Hans"
# What a locale says when a build gains no bullet for it.
fallback() {
	case $1 in
	en-US) printf '%s' "- Bug fixes and internal improvements; no new features in this build." ;;
	zh-Hans) printf '%s' "- 修复缺陷与内部改进，本构建没有新功能。" ;;
	esac
}

section() { # REV LOCALE: the bullets of that locale's section, or nothing
	git show "$1:ios/WhatToTest.md" 2>/dev/null |
		awk -v h="## $2" '
			substr($0, 1, length(h)) == h { on = 1; next }
			on && /^## / { on = 0 }
			on && /^[-*][[:space:]]/ { print }' || true
}

gained() { # FROM LOCALE TO: the bullets TO has that FROM had not
	diff <(section "$1" "$2") <(section "$3" "$2") 2>/dev/null |
		sed -n 's/^> [-*][[:space:]]\([^[:space:]].*\)$/- \1/p' |
		sed -n '1,10p' || true
}

# What the app is, to a tester: its sources, not its tests, builds or notes.
# Not APP: that is the app's App Store Connect ID, from scripts/asc-env, which
# the notes below are set on.
APP_PATHS='ios/GoRex ios/project.yml ios/share ios/tailnet internal/tailnode'

check() { # BASE [TO]: what the pull request in BASE..TO owes testers
	local base=$1 to=${2:-HEAD} from app locale bullets b bad=0 re=
	from=$(git merge-base "$base" "$to")
	re='^(feat|fix|perf|chore|ci|docs|refactor|test)(\([^)]*\))?!?:[[:space:]]'
	# The app's sources, not its tests: a test-only change owes no bullet.
	app=$(git diff --name-only "$from" "$to" -- $APP_PATHS ':!ios/GoRexTests' ':!*_test.go')
	for locale in $LOCALES; do
		bullets=$(gained "$from" "$locale" "$to")
		if [ -n "$app" ] && [ -z "$bullets" ]; then
			echo "::error::ios/WhatToTest.md gains no $locale bullet for the app change this pull request makes"
			bad=1
		fi
		while IFS= read -r b; do
			[ -n "$b" ] || continue
			b=${b#- }
			if [[ $b =~ ^[a-z] ]]; then
				echo "::error::the $locale bullet starts lower-case, like a commit subject: $b"
				bad=1
			fi
			if [[ $b =~ $re ]]; then
				echo "::error::the $locale bullet reads like a commit subject: $b"
				bad=1
			fi
			if [[ $b =~ \(#[0-9]+\)$ ]]; then
				echo "::error::the $locale bullet cites a pull request: $b"
				bad=1
			fi
			if [ ${#b} -gt 200 ]; then
				echo "::error::the $locale bullet is longer than 200 characters"
				bad=1
			fi
		done <<<"$bullets"
	done
	if [ "$bad" -ne 0 ]; then
		echo "A bullet says what a tester gets to try, in their terms: see ios/WhatToTest.md."
		exit 1
	fi
}

if [ "${1:-}" = check ]; then
	shift
	check "${1:-origin/main}" "${2:-HEAD}"
	exit 0
fi

V=${1:?version} B=${2:?build} FROM=${3:?from} TO=${4:-HEAD}
TO=$(git rev-parse "$TO")
en=$(gained "$FROM" en-US "$TO")
zh=$(gained "$FROM" zh-Hans "$TO")
if [ -z "$en" ] && [ -z "$zh" ]; then
	# An app change nobody wrote a bullet for reads as an empty build.
	if ! git diff --quiet "$FROM" "$TO" -- . ':!ios/WhatToTest.md'; then
		echo "::warning::${FROM:0:7}..${TO:0:7} changes the app, but ios/WhatToTest.md gains no bullet"
	fi
elif [ -z "$en" ] || [ -z "$zh" ]; then
	echo "::warning::${FROM:0:7}..${TO:0:7} gains a bullet in one locale only: both get it"
	en=${en:-$zh}
	zh=${zh:-$en}
fi
err=$(mktemp)
trap 'rm -f "$err"' EXIT
for locale in $LOCALES; do
	case $locale in
	en-US) notes=${en:-$(fallback "$locale")} ;;
	*) notes=${zh:-$(fallback "$locale")} ;;
	esac
	for _ in $(seq 40); do
		if ASC_TIMEOUT=60s asc builds test-notes update --app "$APP" --build-number "$B" --platform IOS --version "$V" \
			--locale "$locale" --whats-new "$notes" --output json >/dev/null 2>"$err" ||
			ASC_TIMEOUT=60s asc builds test-notes create --app "$APP" --build-number "$B" --platform IOS --version "$V" \
				--locale "$locale" --whats-new "$notes" --output json >/dev/null 2>"$err"; then
			printf 'NOTES %s (%s) %s\n%s\n' "$V" "$B" "$locale" "$notes"
			continue 2
		fi
		# A build App Store Connect has not got to yet is worth the wait;
		# anything else fails the same way 40 times, so it fails now, with
		# what asc said, instead of 20 minutes later without it.
		if ! grep -qiE 'no build found|not yet|processing|404|429|5[0-9][0-9]|timeout|timed out|dial tcp|connection (reset|refused)' "$err"; then
			if [ -s "$err" ]; then
				sed 's/^/asc: /' "$err" >&2
			else
				echo "asc: builds test-notes failed with no message" >&2
			fi
			exit 1
		fi
		sleep 30
	done
	echo "no build $V ($B) to take notes for $locale" >&2
	exit 1
done
