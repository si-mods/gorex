#!/bin/bash
# testflight: invite testers to Rex Go's internal TestFlight, over the asc
# CLI (brew install asc; `asc auth login` with an App Store Connect API key).
# Internal testing needs no Beta App Review: every build reaches the group.
#
#   testflight invite EMAIL [FIRST LAST]  invite a tester; someone who is no
#                                         App Store Connect user yet is invited
#                                         as one first (Marketing, this app only)
#   testflight testers                    list the testers and their state
#   testflight builds                     list the builds and their processing state
#
# An internal tester must be a user of the App Store Connect team. A new user
# gets Apple's team invitation first: once they accept it, run invite again
# and they get the TestFlight email.
set -euo pipefail

APP=${REXGO_APP_ID:-6831210589}
GROUP=${REXGO_GROUP:-Internal}

usage() { sed -n '2,14s/^# \{0,1\}//p' "$0"; exit 2; }

is_user() { # EMAIL: whether the team has this user
	asc users list --paginate --output json |
		python3 -I -c 'import sys,json
e=sys.argv[1].lower()
sys.exit(0 if any(u["attributes"].get("username","").lower()==e or u["attributes"].get("email","").lower()==e for u in json.load(sys.stdin).get("data",[])) else 1)' "$1"
}

cmd=${1:-}; [ $# -gt 0 ] && shift
case "$cmd" in
invite)
	[ $# -eq 1 ] || [ $# -eq 3 ] || usage
	email=$1
	if is_user "$email"; then
		asc testflight testers invite --app "$APP" --email "$email" --group "$GROUP" --output json >/dev/null
		echo "invited $email to TestFlight ($GROUP)"
	else
		[ $# -eq 3 ] || { echo "$email is no App Store Connect user yet: give FIRST LAST to invite them" >&2; exit 2; }
		asc users invite --email "$email" --first-name "$2" --last-name "$3" --roles MARKETING --visible-app "$APP" --output json >/dev/null
		echo "invited $email to the App Store Connect team; once they accept, run: $(basename "$0") invite $email"
	fi ;;
testers)
	asc testflight testers list --app "$APP" --output table ;;
builds)
	asc builds list --app "$APP" --output table ;;
*) usage ;;
esac
