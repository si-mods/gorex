#!/bin/bash
# upload: archive Rex Go and upload it to TestFlight. Run on a Mac with Xcode,
# asc and xcodegen, from ios/, after scripts/build-ghostty-vt.sh and
# scripts/build-tailnet. Signing is cloud-managed, by the App Store Connect
# API key: ASC_KEY_PATH, ASC_KEY_ID and ASC_ISSUER_ID, by default the key in
# ~/.appstoreconnect/private_keys.
set -euo pipefail
cd "$(dirname "$0")/.."
. scripts/asc-env
export ASC_KEY_ID ASC_ISSUER_ID ASC_PRIVATE_KEY_PATH
A=(-allowProvisioningUpdates -authenticationKeyPath "$ASC_PRIVATE_KEY_PATH" -authenticationKeyID "$ASC_KEY_ID" -authenticationKeyIssuerID "$ASC_ISSUER_ID")
# Builds count up from 1 for each version, as TestFlight shows them: 1.1 (3).
# App Store Connect has the last one; BUILD sets it.
V=$(sed -n 's/^ *MARKETING_VERSION: "\([0-9.]*\)"$/\1/p' project.yml)
[[ $V =~ ^[0-9]+(\.[0-9]+)+$ ]] || { echo "no MARKETING_VERSION in project.yml" >&2; exit 1; }
B=${BUILD:-$(ASC_TIMEOUT=90s asc builds list --app "$APP" --version "$V" --processing-state all --limit 200 --output json |
  python3 -I -c 'import sys,json; print(1+max([int(b["attributes"]["version"]) for b in json.load(sys.stdin)["data"]], default=0))')}
[[ $B =~ ^[0-9]+$ ]] || { echo "bad build number: $B" >&2; exit 1; }
# The commit About shows; none when run from an archive without .git.
C=$(git rev-parse --short=7 HEAD 2>/dev/null || true)
xcodegen generate -q
mkdir -p build
cat > build/export.plist <<P
<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0"><dict>
<key>method</key><string>app-store-connect</string>
<key>destination</key><string>upload</string>
<key>teamID</key><string>57QL6YCAH5</string>
<key>signingStyle</key><string>automatic</string>
<key>manageAppVersionAndBuildNumber</key><false/>
</dict></plist>
P
# The packages, GhosttyKit's binaries from GitHub among them, before the
# archive: a download GitHub fails (a 504 at times) is tried again.
for n in 1 2 3; do
  xcodebuild -resolvePackageDependencies -scheme GoRex > build/resolve.log 2>&1 && break
  grep -E "error|failed" build/resolve.log | tail -5 || true
  [[ $n -lt 3 ]] || exit 1
  sleep $((n * 30))
done
# Another upload can take the build number between the query and ours: then
# take the next one, twice at most.
for try in 0 1 2; do
  echo "BUILD $V ($B)"
  rm -rf build/GoRex.xcarchive build/export
  xcodebuild -scheme GoRex -destination generic/platform=iOS -archivePath build/GoRex.xcarchive \
    CURRENT_PROJECT_VERSION="$B" GOREX_COMMIT="$C" CODE_SIGNING_ALLOWED=NO archive > build/archive.log 2>&1 || { grep -E "error" build/archive.log | tail -15; exit 1; }
  echo ARCHIVED
  xcodebuild -exportArchive -archivePath build/GoRex.xcarchive -exportOptionsPlist build/export.plist -exportPath build/export "${A[@]}" > build/export.log 2>&1 && break
  grep -iE "error" build/export.log | tail -15 || true
  [[ $try -lt 2 ]] && grep -qiE "redundant binary upload|already (been )?(used|uploaded)|must be higher than the previously" build/export.log || exit 1
  B=$((B + 1))
done
tail -3 build/export.log
echo "UPLOADED $V ($B)"
